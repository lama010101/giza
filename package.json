{
  "name": "giza",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "playwright test",
    "test:integration:ui": "playwright test --ui",
    "governance": "node scripts/governance-smoke.mjs",
    "docs": "node scripts/docs.mjs",
    "generate-assets": "tsx scripts/generateExportAssets.ts",
    "verify-assets": "tsx scripts/verifyExportAssets.mjs",
    "generate-asset-catalog": "tsx scripts/generateAssetCatalog.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@react-three/drei": "9.109.2",
    "@react-three/fiber": "8.17.5",
    "@react-three/rapier": "1.4.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-error-boundary": "4.0.13",
    "three": "0.166.0",
    "zod": "3.23.8",
    "zustand": "4.5.5"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "19.2.2",
    "@playwright/test": "1.45.3",
    "@testing-library/jest-dom": "6.4.8",
    "@testing-library/react": "16.0.0",
    "@testing-library/user-event": "14.5.2",
    "@types/node": "20.14.12",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@types/three": "0.166.0",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "@vitejs/plugin-react": "4.3.1",
    "commitlint": "19.3.0",
    "eslint": "8.57.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-prettier": "5.2.1",
    "eslint-plugin-react-hooks": "4.6.2",
    "eslint-plugin-react-refresh": "0.4.9",
    "husky": "9.1.4",
    "jsdom": "24.1.1",
    "json-schema-to-markdown": "1.1.1",
    "lint-staged": "15.2.8",
    "prettier": "3.3.3",
    "tsx": "4.23.1",
    "typedoc": "0.26.5",
    "typescript": "5.5.4",
    "vite": "5.4.2",
    "vitest": "2.0.5",
    "zod-to-json-schema": "3.23.3"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,jsx,json,md,css}": [
      "prettier --write"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  }
}
